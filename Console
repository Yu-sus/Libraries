local Console = {}

-- Serviço seguro com suporte a cloneref
local function getService(name)
    local svc = game:GetService(name)
    if cloneref then return cloneref(svc) end
    return svc
end

local CoreGui = getService("CoreGui")
local Players = getService("Players")
local TweenService = getService("TweenService")
local UserInputService = getService("UserInputService")
local Workspace = getService("Workspace")

-- Variáveis internas
local INSTANCE = nil
local isVisible = false
local titleText = "Secure Console"
local descriptionText = ""

-- Controle de listeners
local inputConnection = nil
local lastRebuildTime = 0

-- Helper para obter parent adequado
local function getUIParent()
    if CoreGui and CoreGui.Parent then return CoreGui end
    local plr = Players.LocalPlayer
    if plr and plr:FindFirstChild("PlayerGui") then return plr.PlayerGui end
    return nil
end

-- Criação segura de instâncias
local function safeCreate(className, parent, props)
    local ok, obj = pcall(function()
        local inst = Instance.new(className)
        if parent then inst.Parent = parent end
        if props then
            for k, v in pairs(props) do
                inst[k] = v
            end
        end
        return inst
    end)
    if ok then return obj end
    warn("[Console] Falha ao criar", className, ":", obj)
    return nil
end

-- Constrói toda a interface
local function buildUI()
    if INSTANCE then return INSTANCE end

    local parent = getUIParent()
    if not parent then
        warn("[Console] Nenhum parent disponível.")
        return nil
    end

    -- Tamanho da tela para centralização inicial
    local screenSize = Vector2.new(1920, 1080)
    pcall(function()
        local cam = Workspace.CurrentCamera
        if cam then screenSize = cam.ViewportSize end
    end)

    local gui = safeCreate("ScreenGui", parent, {
        Name = "SecureConsoleUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true
    })
    if not gui then return nil end

    local main = safeCreate("Frame", gui, {
        Name = "MainFrame",
        Size = UDim2.new(0, 700, 0, 500),
        Position = UDim2.new(0, (screenSize.X - 700) / 2, 0, (screenSize.Y - 500) / 2),
        BackgroundColor3 = Color3.fromRGB(22, 22, 28),
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Visible = false,
        -- AnchorPoint removido: o canto superior esquerdo fica fixo ao redimensionar
    })
    if not main then return nil end

    local corner = safeCreate("UICorner", main, { CornerRadius = UDim.new(0, 10) })
    local stroke = safeCreate("UIStroke", main, {
        Color = Color3.fromRGB(70, 70, 90),
        Thickness = 1.5
    })

    local topbar = safeCreate("Frame", main, {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Color3.fromRGB(30, 30, 38),
        BackgroundTransparency = 0,
        BorderSizePixel = 0
    })
    if not topbar then return nil end

    local topCorner = safeCreate("UICorner", topbar, { CornerRadius = UDim.new(0, 10) })

    local title = safeCreate("TextLabel", topbar, {
        Name = "TitleLabel",
        Size = UDim2.new(1, -80, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = titleText,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamBold,
        TextSize = 18
    })

    local desc = safeCreate("TextLabel", topbar, {
        Name = "DescLabel",
        Size = UDim2.new(1, -80, 0, 16),
        Position = UDim2.new(0, 12, 0, 24),
        BackgroundTransparency = 1,
        Text = descriptionText,
        TextColor3 = Color3.fromRGB(160, 160, 180),
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        Visible = (#descriptionText > 0)
    })

    local closeBtn = safeCreate("TextButton", topbar, {
        Name = "CloseButton",
        Size = UDim2.new(0, 32, 1, -8),
        Position = UDim2.new(1, -38, 0, 4),
        BackgroundColor3 = Color3.fromRGB(50, 50, 60),
        BackgroundTransparency = 0,
        Text = "✕",
        TextColor3 = Color3.fromRGB(220, 220, 230),
        Font = Enum.Font.Gotham,
        TextSize = 16,
        AutoButtonColor = false,
        BorderSizePixel = 0
    })
    if closeBtn then
        local closeCorner = safeCreate("UICorner", closeBtn, { CornerRadius = UDim.new(0, 6) })
        closeBtn.MouseButton1Click:Connect(function()
            Console:Hide()
        end)
    end

    local content = safeCreate("Frame", main, {
        Name = "Content",
        Size = UDim2.new(1, -20, 1, -56),
        Position = UDim2.new(0, 10, 0, 46),
        BackgroundColor3 = Color3.fromRGB(16, 16, 20),
        BackgroundTransparency = 0,
        BorderSizePixel = 0
    })
    if not content then return nil end

    local contentCorner = safeCreate("UICorner", content, { CornerRadius = UDim.new(0, 6) })

    local scroll = safeCreate("ScrollingFrame", content, {
        Name = "Output",
        Size = UDim2.new(1, -8, 1, -8),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 6,
        ScrollBarImageColor3 = Color3.fromRGB(70, 70, 90)
    })
    if not scroll then return nil end

    local layout = safeCreate("UIListLayout", scroll, {
        Name = "MessageLayout",
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2)
    })
    if layout then
        -- Rola automaticamente para o final quando novo conteúdo é adicionado
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            local h = layout.AbsoluteContentSize.Y
            if h > 0 then
                scroll.CanvasSize = UDim2.new(0, 0, 0, h + 8)
                scroll.CanvasPosition = Vector2.new(0, h)
            end
        end)
    end

    -- Alça de redimensionamento
    local resize = safeCreate("Frame", main, {
        Name = "ResizeHandle",
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -24, 1, -24),
        BackgroundColor3 = Color3.fromRGB(60, 60, 80),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        ZIndex = 10
    })
    if resize then
        local resizeCorner = safeCreate("UICorner", resize, { CornerRadius = UDim.new(0, 4) })
        for i = 1, 3 do
            local bar = safeCreate("Frame", resize, {
                Size = UDim2.new(0, 10, 0, 1.5),
                Position = UDim2.new(0.5, -5, 0, 2 + (i - 1) * 5),
                BackgroundColor3 = Color3.fromRGB(200, 200, 220),
                BorderSizePixel = 0
            })
        end
    end

    -- Variáveis de arrasto
    local dragging = false
    local dragStart = nil
    local dragStartPos = nil -- posição original do main (canto superior esquerdo)

    -- Variáveis de redimensionamento
    local resizing = false
    local resizeStart = nil
    local resizeStartSize = nil -- tamanho original

    -- Eventos de arrasto na barra superior
    topbar.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            dragStartPos = main.Position
        end
    end)

    topbar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- Eventos de redimensionamento na alça
    if resize then
        resize.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                resizing = true
                resizeStart = input.Position
                resizeStartSize = main.Size
            end
        end)

        resize.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                resizing = false
            end
        end)
    end

    -- Listener unificado de movimento do mouse
    if inputConnection then
        inputConnection:Disconnect()
    end
    inputConnection = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

        if dragging and dragStart and dragStartPos then
            local delta = input.Position - dragStart
            local newX = math.floor(dragStartPos.X.Offset + delta.X)
            local newY = math.floor(dragStartPos.Y.Offset + delta.Y)
            main.Position = UDim2.new(0, newX, 0, newY)
        elseif resizing and resizeStartSize and resizeStart then
            local delta = input.Position - resizeStart
            local newW = math.max(400, resizeStartSize.X.Offset + delta.X)
            local newH = math.max(300, resizeStartSize.Y.Offset + delta.Y)
            main.Size = UDim2.new(0, newW, 0, newH)
            -- Como AnchorPoint é (0,0), o canto superior esquerdo permanece fixo
        end
    end)

    topbar.ZIndex = 5

    INSTANCE = gui
    isVisible = false
    return gui
end

-- Funções auxiliares internas
local function getMainFrame()
    if not INSTANCE then return nil end
    return INSTANCE:FindFirstChild("MainFrame")
end

local function getOutput()
    local main = getMainFrame()
    if not main then return nil end
    local content = main:FindFirstChild("Content")
    if not content then return nil end
    return content:FindFirstChild("Output")
end

local function addMessage(text, color, withTimestamp)
    if not INSTANCE then
        buildUI()
        if not INSTANCE then return end
    end

    local output = getOutput()
    if not output then
        warn("[Console] Output não encontrado.")
        return
    end

    local timestamp = ""
    if withTimestamp ~= false then
        timestamp = os.date("[%H:%M:%S] ")
    end

    -- Criação segura do rótulo, agora com altura automática
    local ok, label = pcall(function()
        local lbl = Instance.new("TextLabel")
        lbl.Name = "Message"
        lbl.Size = UDim2.new(1, -6, 0, 0)            -- altura 0, se expandirá automaticamente
        lbl.AutomaticSize = Enum.AutomaticSize.Y      -- ajusta a altura ao texto
        lbl.BackgroundTransparency = 1
        lbl.Text = timestamp .. tostring(text)
        lbl.TextColor3 = color or Color3.fromRGB(200, 200, 210)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 14
        lbl.TextWrapped = true
        lbl.TextTruncate = Enum.TextTruncate.None
        lbl.Parent = output
        return lbl
    end)

    if not ok then
        warn("[Console] Erro ao criar mensagem:", label)
    end
    -- A rolagem e o CanvasSize são atualizados automaticamente pelo listener de AbsoluteContentSize
end

-- Métodos públicos do Console
function Console:Show()
    if not INSTANCE then
        buildUI()
        if not INSTANCE then return end
    end

    local main = getMainFrame()
    if not main then return end
    main.Visible = true
    isVisible = true
    main.BackgroundTransparency = 1
    local tween = TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0
    })
    tween:Play()
end

function Console:Hide()
    if not INSTANCE then
        isVisible = false
        return
    end
    local main = getMainFrame()
    if not main then
        isVisible = false
        return
    end
    local tween = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        BackgroundTransparency = 1
    })
    tween:Play()
    tween.Completed:Connect(function()
        main.Visible = false
        isVisible = false
    end)
end

function Console:Toggle()
    if not INSTANCE then
        buildUI()
        if not INSTANCE then return end
    end
    if isVisible then
        self:Hide()
    else
        self:Show()
    end
end

function Console:Print(message, color, withTimestamp)
    if type(message) ~= "string" then
        message = tostring(message)
    end
    addMessage(message, color, withTimestamp)
end

function Console:SetTitle(newTitle)
    if type(newTitle) ~= "string" then return end
    titleText = newTitle
    if INSTANCE then
        local main = getMainFrame()
        if main then
            local topbar = main:FindFirstChild("Topbar")
            if topbar then
                local lbl = topbar:FindFirstChild("TitleLabel")
                if lbl then lbl.Text = newTitle end
            end
        end
    end
end

function Console:SetDescription(newDesc)
    if type(newDesc) ~= "string" then return end
    descriptionText = newDesc
    if INSTANCE then
        local main = getMainFrame()
        if main then
            local topbar = main:FindFirstChild("Topbar")
            if topbar then
                local lbl = topbar:FindFirstChild("DescLabel")
                if lbl then
                    lbl.Text = newDesc
                    lbl.Visible = (#newDesc > 0)
                end
            end
        end
    end
end

function Console:GetVisible()
    return isVisible
end

function Console:Clear()
    local output = getOutput()
    if not output then return end
    for _, child in ipairs(output:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    output.CanvasSize = UDim2.new(0, 0, 0, 0)
end

-- Wrapper seguro com recuperação limitada
local function safeWrapper(func)
    return function(...)
        local ok, err = pcall(func, ...)
        if not ok then
            warn("[Console] Erro interno:", err, debug.traceback())
            -- Tentativa de reconstrução apenas se a UI foi corrompida
            if type(err) == "string" and (err:find("UI") or err:find("Parent") or err:find("Visible") or err:find("UDim2") or err:find("Offset") or err:find("Size")) then
                local now = tick()
                if now - lastRebuildTime > 5 then  -- throttle de 5 segundos
                    lastRebuildTime = now
                    INSTANCE = nil
                    isVisible = false
                    if inputConnection then
                        inputConnection:Disconnect()
                        inputConnection = nil
                    end
                    buildUI()
                end
            end
        end
    end
end

Console.Show = safeWrapper(Console.Show)
Console.Hide = safeWrapper(Console.Hide)
Console.Toggle = safeWrapper(Console.Toggle)
Console.Print = safeWrapper(Console.Print)
Console.SetTitle = safeWrapper(Console.SetTitle)
Console.SetDescription = safeWrapper(Console.SetDescription)
Console.Clear = safeWrapper(Console.Clear)
Console.GetVisible = safeWrapper(Console.GetVisible)

local initOk, initErr = pcall(function()
    buildUI()
end)
if not initOk then
    warn("[Console] Falha na inicialização:", initErr, debug.traceback())
end

return Console
